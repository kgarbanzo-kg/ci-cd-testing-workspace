# Settings for the sqlfluff extension, this can be used for both local and CI execution
[sqlfluff]
dialect = snowflake
# Allows templating variables with '{{ variable }}'
templater = jinja
sql_file_exts = .sql
# Templating and parsing are ignored because they do not have a good understanding of the Snowflake context; lexing and linting are still being checked
ignore = templating, parsing 
# The default (80) is too small
max_line_length = 120 


[sqlfluff:indentation]
indented_joins = True
indented_using_on = True
template_blocks_indent = True

# All capitalisations are upper in true Snowflake fashion
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = upper
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper